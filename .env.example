# Phone MCP — environment template
# Copy to .env (gitignored): cp .env.example .env
# All values are local-only. Never commit .env, keystores, or tokens.

# Ktor listener (see ServerConfig; keep 0.0.0.0 LAN-only)
PHONE_MCP_PORT=8080
PHONE_MCP_HOST=0.0.0.0

# Auth token for scripts/verify-mcp.sh (or export TOKEN=; prefers PHONE_MCP_TOKEN)
PHONE_MCP_TOKEN=

# Harness bridge (bridges/phone-mcp-bridge.*, docs/harness.md)
# Full endpoint URL + pinned TLS fingerprint (dashboard, colons ok).
PHONE_MCP_URL=https://192.168.1.50:8080/mcp
PHONE_MCP_SHA256=
# PEM from scripts/export-ca.sh (verified direct-remote mode, §2b). Optional.
PHONE_MCP_CAFILE=
# Per-call budgets (bridges only): ceiling / fast (no duration arg) / headroom.
PHONE_MCP_TIMEOUT_MS=35000
PHONE_MCP_FAST_MS=15000
PHONE_MCP_MARGIN_MS=10000
# Set to 1 only on trusted LAN to skip TLS verification instead of pinning.
PHONE_MCP_INSECURE=

# Optional BLE peer for verify-mcp.sh ble_subscribe probe
BLE_PEER=

# Release signing (Play upload; without these, release falls back to debug signing — not for upload)
PHONE_MCP_KEYSTORE_FILE=
PHONE_MCP_KEYSTORE_PASSWORD=
PHONE_MCP_KEY_ALIAS=phone-mcp
PHONE_MCP_KEY_PASSWORD=

# Local SDK override (normally from local.properties sdk.dir / ANDROID_HOME; set only if non-standard)
ANDROID_HOME=
